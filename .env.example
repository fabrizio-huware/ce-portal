# Copia in backend/.env per lo sviluppo locale. NON committare il file .env.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://ceportal:ceportal@localhost:5432/ceportal
CORS_ORIGINS=http://localhost:5173

# Porta del database locale. Se la 5432 è occupata:  DB_PORT=5433 make db
# e imposta la stessa porta in DATABASE_URL (e in TEST_DATABASE_URL per i test).
# DB_PORT=5432
# TEST_DATABASE_URL=postgresql+psycopg://ceportal:ceportal@localhost:5432/ceportal_test

# --- Autenticazione ---
# Segreto per firmare i token di sessione. In locale c'è un valore di comodo;
# in test e prod è OBBLIGATORIO (almeno 32 caratteri casuali) e va tenuto in Secret Manager.
# Per generarlo:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Client ID OAuth di Google (serve dallo Step 8; in locale si usa il login simulato)
# GOOGLE_OAUTH_CLIENT_ID=
# Domini email ammessi al login, separati da virgola
ALLOWED_EMAIL_DOMAINS=huware.com
# Crea questo admin all'avvio SOLO se non esiste ancora nessun utente
# BOOTSTRAP_ADMIN_EMAIL=nome.cognome@huware.com

# --- Email (Step 6) ---
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# MAIL_FROM=teamdata@huware.com
