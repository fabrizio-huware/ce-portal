# Copia questo file in terraform.tfvars (non va nel repository) e sostituisci i valori.
project_id        = "ID-DEL-PROGETTO-PROD"
github_repository = "ORGANIZZAZIONE/REPOSITORY"

# Client ID OAuth di Google per l'accesso (si crea a mano nella console: docs/deploy.md).
google_oauth_client_id = ""

# Programmi esterni (account di servizio Google): oltre all'indirizzo pubblico del portale, che vale sempre
# come audience del token, qui si possono aggiungere altri indirizzi (di norma resta vuoto).
s2s_extra_audiences = []

# Email del primo amministratore: si crea al primo avvio, se il database non ha utenti.
bootstrap_admin_email = "nome.cognome@huware.com"

# Email: "mailjet" le invia davvero (servono le chiavi nei segreti, docs/deploy.md passo 5);
# "console" NON le invia: le scrive solo nel log (è il predefinito dell'ambiente di test).
mail_backend = "mailjet"

# Chi riceve gli avvisi (servizio non raggiungibile, errori, lavori falliti).
alert_email = "teamdata@huware.com"

# Se l'organizzazione vieta di dare accesso a "allUsers" (errore «do not belong to a permitted customer»):
# public_access_method = "disable_iam_check"

# Con un dominio proprio: public_url_override = "https://ce.example.com"
# Per far leggere al progetto di produzione le immagini del registro di test:
# registry_reader_members = ["serviceAccount:service-NUMERO-PROGETTO-PROD@serverless-robot-prod.iam.gserviceaccount.com"]
